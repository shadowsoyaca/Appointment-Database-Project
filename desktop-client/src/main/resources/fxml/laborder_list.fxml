<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.appointmentProject.desktop.controller.laborder.LabOrderListController"
      alignment="TOP_CENTER"
      spacing="20"
      style="-fx-padding: 20;">

    <!-- Top buttons -->
    <HBox spacing="15" alignment="CENTER" style="-fx-padding: 10;">
        <Button text="Create Lab Order"
                style="-fx-font-size: 16px; -fx-padding: 8 16;"
                onAction="#handleCreateLabOrder"/>

        <Button text="Edit Lab Order"
                style="-fx-font-size: 16px; -fx-padding: 8 20;"
                onAction="#handleEditLabOrder"/>

        <Button text="Back"
                style="-fx-font-size: 16px; -fx-padding: 8 16;"
                onAction="#handleBack"/>
    </HBox>

    <!-- Search bar -->
    <TextField fx:id="searchField"
               promptText="Search lab orders..."
               maxWidth="300"/>

    <!-- Message label -->
    <Label fx:id="messageLabel"
           textFill="red"
           style="-fx-font-size:14px;"
           text=""/>

    <!-- Title -->
    <Label text="Lab Orders"
           style="-fx-font-size:24px; -fx-font-weight:bold;"/>

    <!-- Table -->
    <TableView fx:id="labOrdersTable"
               prefWidth="800"
               prefHeight="400">
        <columns>
            <TableColumn fx:id="idCol" text="ID" prefWidth="80"/>
            <TableColumn fx:id="appointmentIdCol" text="Appointment ID" prefWidth="140"/>
            <TableColumn fx:id="providerRequesterIdCol" text="Provider Requester ID" prefWidth="130"/>
            <TableColumn fx:id="providerReceiverIdCol" text="Provider Receiver ID" prefWidth="130"/>
            <TableColumn fx:id="nurseIdCol" text="Nurse ID" prefWidth="130"/>
            <TableColumn fx:id="patientIdCol" text="Patient ID" prefWidth="130"/>
            <TableColumn fx:id="dateOfCompletionCol" text="Date of Completion" prefWidth="200"/>
            <TableColumn fx:id="testingPurposeCol" text="Testing Purpose" prefWidth="200"/>
            <TableColumn fx:id="resultsCol" text="Results" prefWidth="130"/>
        </columns>
    </TableView>

</VBox>
