<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.appointmentProject.desktop.controller.insurance.InsuranceCreateController"
      spacing="12"
      style="-fx-padding: 20;">

    <Label text="Create Insurance"
           style="-fx-font-size: 24px; -fx-font-weight: bold;" />

    <Label fx:id="messageLabel" textFill="red" />

    <TextField fx:id="insuranceNameField" promptText="Insurance Name" />
    <TextField fx:id="phoneField" promptText="Phone (formatted OK)" />
    <TextField fx:id="emailField" promptText="Email" />
    <TextField fx:id="addressField" promptText="Address" />


    <HBox spacing="10">
        <Button text="Create" onAction="#handleCreateInsurance" />
        <Button text="Back" onAction="#handleBack" />
    </HBox>

</VBox>
