<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.appointmentProject.desktop.controller.insurance.InsuranceListController"
      spacing="12"
      style="-fx-padding: 20;">

    <!-- Title -->
    <Label text="Insurance Records"
           style="-fx-font-size: 24px; -fx-font-weight: bold;" />

    <!-- Search Bar -->
    <HBox spacing="10">
        <TextField fx:id="searchField" promptText="Search insurance..." />
        <Button text="Refresh" onAction="#handleRefresh"/>
    </HBox>

    <!-- Table -->
    <TableView fx:id="insuranceTable" prefHeight="400">
        <columns>
            <TableColumn fx:id="idColumn" text="ID" prefWidth="60" />
            <TableColumn fx:id="nameColumn" text="Insurance Name" prefWidth="180" />
            <TableColumn fx:id="phoneColumn" text="Phone" prefWidth="140" />
            <TableColumn fx:id="emailColumn" text="Email" prefWidth="200" />
            <TableColumn fx:id="addressColumn" text="Address" prefWidth="200" />
        </columns>
    </TableView>

    <!-- Buttons -->
    <HBox spacing="10">
        <Button text="Add Insurance" onAction="#handleCreateInsurance"/>
        <Button text="Edit Insurance" onAction="#handleEditInsurance"/>
        <Button text="Delete Insurance" onAction="#handleDeleteInsurance"/>
        <Button text="Back" onAction="#handleBack"/>
    </HBox>

    <Label fx:id="messageLabel" textFill="red" />

</VBox>
