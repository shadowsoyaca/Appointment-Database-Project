<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.appointmentProject.desktop.controller.appointment.CreateAppointmentController">

    <top>
        <VBox spacing="8">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <Label text="Create Appointment"
                   style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
        </VBox>
    </top>

    <center>
        <GridPane hgap="10" vgap="10">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <!-- Patient ID -->
            <Label text="Patient ID:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="patientIdField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <!-- Provider ID -->
            <Label text="Provider ID:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="providerIdField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <!-- Billing ID -->
            <Label text="Billing ID:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="billingIdField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <!-- Nurse ID (optional) -->
            <Label text="Nurse ID (optional):" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <TextField fx:id="nurseIdField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

            <!-- Prescription ID (optional) -->
            <Label text="Prescription ID (optional):" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <TextField fx:id="prescriptionIdField" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

            <!-- Lab Order ID (optional) -->
            <Label text="Lab Order ID (optional):" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
            <TextField fx:id="labOrderIdField" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

            <!-- Date Picker -->
            <Label text="Appointment Date:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
            <DatePicker fx:id="appointmentDatePicker" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

            <!-- Time ComboBox -->
            <Label text="Appointment Time:" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
            <ComboBox fx:id="appointmentTimeCombo" GridPane.rowIndex="7" GridPane.columnIndex="1"/>

            <!-- Room Number -->
            <Label text="Room Number:" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
            <TextField fx:id="roomNumberField" GridPane.rowIndex="8" GridPane.columnIndex="1"/>

            <!-- Reason -->
            <Label text="Reason for Visiting:" GridPane.rowIndex="9" GridPane.columnIndex="0"/>
            <TextArea fx:id="reasonField"
                      prefRowCount="3"
                      GridPane.rowIndex="9"
                      GridPane.columnIndex="1"/>
        </GridPane>
    </center>

    <bottom>
        <HBox spacing="12">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>

            <Button text="Save" onAction="#handleSave"/>
            <Button text="Cancel" onAction="#handleCancel"/>
            <Label fx:id="formError" style="-fx-text-fill: red;"/>
        </HBox>
    </bottom>

</BorderPane>
