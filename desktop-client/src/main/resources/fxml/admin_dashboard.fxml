<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.appointmentProject.desktop.controller.AdminDashboardController"
      alignment="CENTER"
      spacing="20">

    <Label text="Admin Dashboard"
           style="-fx-font-size: 24px; -fx-font-weight: bold;" />

    <Label text="(Placeholder — build features soon)" />

    <Button text="Log Out"
            onAction="#handleLogout" />
            
    <Button fx:id="btnManagePartners"
        text="Manage Partners"
        onAction="#handleManagePartners"
        style="-fx-font-size: 14px; -fx-padding: 8px 16px;" />
            
</VBox>

